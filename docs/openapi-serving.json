    "/predict": {
      "post": {
        "description": "Rows are validated against the model's feature schema first (`GET /model`): exactly its input columns, clean numbers in numeric columns. Each row gets its own prediction id and is logged with its input, output, model version and latency; a logging failure never fails the prediction (`logged: false`).",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
