# Copy to .env (git-ignored) and set a password. No real values are committed.
# Used by compose.yaml and by the application's database settings (src/automl_ops/db/config.py).
POSTGRES_PASSWORD=
# Optional overrides (defaults shown):
# AUTOML_DB_HOST=127.0.0.1
# AUTOML_DB_PORT=55432
# AUTOML_DB_USER=automl
# AUTOML_DB_NAME=automl_ops
# AUTOML_DATABASE_URL=   # a full URL replaces all of the above
# MLflow tracking (P4-2b). SQLite stays the default; select PostgreSQL explicitly:
# AUTOML_MLFLOW_BACKEND=postgresql
# AUTOML_MLFLOW_DB_NAME=mlflow
# AUTOML_MLFLOW_ARTIFACT_ROOT=   # absolute path; default <project>/data/mlflow-pg/artifacts (max 157 characters)
# Control-plane API (P4-3):
# AUTOML_API_PORT=8100
# AUTOML_UI_ORIGIN=http://localhost:5173   # the one browser origin allowed to call the API
# AUTOML_STORE_DIR=   # default <project>/data/store
# Jobs (P4-4). Tracking is opt-in per job (`track: true`). With the PostgreSQL backend above it logs to the
# `mlflow` database; with SQLite it needs its own directory, never the original archive data/mlflow.
# AUTOML_JOBS_MLFLOW_DIR=   # e.g. data/mlflow-jobs
# AUTOML_MODELS_DIR=   # default <project>/data/models
# AUTOML_REGISTRY_MIRROR=off   # on: mirror the model registry into MLflow (P4-6); off by default
# Serving app (P4-7): the port the serving app listens on (127.0.0.1 only) and the control plane calls.
# AUTOML_SERVING_PORT=8200
